{
  "name": "modus-golf-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.mjs",
    "ios:check": "node scripts/prepare-mac.mjs --check",
    "ios:prepare": "node scripts/prepare-mac.mjs",
    "ios:sync": "cap sync ios",
    "ios:open": "cap open ios",
    "postinstall": "node scripts/patch-auth.mjs",
    "preios:sync": "node scripts/patch-auth.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "8.5.2",
    "@capacitor-firebase/firestore": "8.5.2",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/ios": "8.5.3",
    "@capacitor/share": "^8.0.3",
    "@noble/hashes": "2.0.1",
    "firebase": "^12.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6",
    "uuid": "^11.1.1"
  }
}
