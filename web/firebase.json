{
  "hosting": {
    "site": "modus-golf-ea469",
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [{ "source": "**", "destination": "/index.html" }],
    "headers": [
      {
        "source": "**",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/assets/**",
        "headers": [{ "key": "Cache-Control", "value": "public,max-age=31536000,immutable" }]
      }
    ]
  },
  "firestore": {
    "rules": "MODUS_Golf_Firebase_AI_Starter/firebase/firestore.rules"
  },
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "singleProjectMode": true,
    "ui": {
      "enabled": false
    },
    "auth": {
      "port": 9099
    }
  },
  "auth": {
    "providers": {
      "googleSignIn": {
        "oAuthBrandDisplayName": "MODUS Golf",
        "authorizedRedirectUris": [
          "https://modus-golf-ea469.firebaseapp.com/__/auth/handler",
          "http://localhost"
        ],
        "supportEmail": "lbrowningsgc@gmail.com"
      },
      "emailPassword": true
    }
  }
}
